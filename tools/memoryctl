#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED="$(readlink -f "${SCRIPT_PATH}" 2>/dev/null || true)"
  if [[ -n "${RESOLVED}" ]]; then
    SCRIPT_PATH="${RESOLVED}"
  fi
fi

ROOT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
PY_VENV="${ROOT_DIR}/.venv/bin/python"
SCRIPT="${ROOT_DIR}/tools/memoryctl.py"

if [[ -n "${PYTHON_BIN:-}" ]] && [[ -x "${PYTHON_BIN}" ]]; then
  exec "${PYTHON_BIN}" "${SCRIPT}" "$@"
fi

if [[ -x "${PY_VENV}" ]]; then
  exec "${PY_VENV}" "${SCRIPT}" "$@"
fi

if [[ -n "${CONDA_PREFIX:-}" ]] && [[ -x "${CONDA_PREFIX}/bin/python" ]]; then
  exec "${CONDA_PREFIX}/bin/python" "${SCRIPT}" "$@"
fi

for cand in \
  "/opt/homebrew/Caskroom/miniconda/base/envs/ml/bin/python" \
  "${HOME}/miniforge3/envs/ml/bin/python" \
  "${HOME}/miniconda3/envs/ml/bin/python" \
  "${HOME}/anaconda3/envs/ml/bin/python"; do
  if [[ -x "${cand}" ]]; then
    exec "${cand}" "${SCRIPT}" "$@"
  fi
done

exec python3 "${SCRIPT}" "$@"
